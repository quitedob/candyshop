# ===========================================
# CandyPro OEM API Configuration
# ===========================================

# Server Configuration
PORT=8080
ENVIRONMENT=development
READ_TIMEOUT=60
WRITE_TIMEOUT=660
IDLE_TIMEOUT=120

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=candypro
DB_PASSWORD=your_secure_password_here
DB_NAME=candypro
DB_SSLMODE=disable

# Database Connection Pool (Issue 6 — configurable pool)
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME_MIN=60

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=noreply@candypro.com
FROM_NAME=CandyPro OEM

# File Upload Configuration
# STORAGE_DRIVER options: local (default), s3 (AWS S3 / MinIO), oss (Alibaba Cloud OSS, S3-compatible)
STORAGE_DRIVER=local
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
UPLOAD_URL=/uploads

# S3 / OSS Cloud Storage (required when STORAGE_DRIVER=s3 or oss)
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://s3.amazonaws.com
# For Alibaba Cloud OSS: S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# For MinIO: S3_ENDPOINT=http://localhost:9000
# S3_CDN_DOMAIN=https://cdn.example.com

# Security Configuration
# JWT Secret (required, min 32 characters — generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-strong-value-at-least-32-characters-long
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Comma-separated list of allowed CORS origins (or set FRONTEND_URL for single origin)
# CORS_ORIGINS=https://candypro-oem.com,https://admin.candypro-oem.com
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
PUBLIC_AI_RATE_LIMIT_PER_MINUTE=15
PUBLIC_INQUIRY_RATE_LIMIT_PER_MINUTE=10
ENABLE_SWAGGER=true
ENABLE_SUPPLIER_PORTAL=false
TRUSTED_PROXIES=127.0.0.1

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayPal Payment Gateway
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true

# KYB bypass thresholds (0 = disabled)
KYB_BYPASS_MAX_ORDER_USD=0
KYB_BYPASS_SAMPLE_MAX_ORDER_USD=0
KYB_SAMPLE_PRODUCT_IDS=

# Event outbox relay
EVENT_OUTBOX_RELAY_INTERVAL_SECONDS=30
AUTO_INVOICE_ON_PAYMENT=true

# Auto seed (development only)
AUTO_SEED_DATA=false

# Exchange Rates (format: CODE:rate,CODE:rate - base currency is USD)
# Used by frontend currency selector for reference price display
EXCHANGE_RATES=EUR:0.92,CNY:7.24,GBP:0.79,JPY:149.50,SAR:3.75,AED:3.67,KRW:1320.00,SGD:1.34,MYR:4.68,THB:35.50,VND:24850.00,IDR:15700.00,PHP:56.20

# Pending-confirmation order draft cleanup (stock reservation release)
ORDER_DRAFT_CLEANUP_ENABLED=true
ORDER_DRAFT_CLEANUP_INTERVAL_MINUTES=5
ORDER_DRAFT_EXPIRE_MINUTES=60
ORDER_DRAFT_CLEANUP_BATCH_SIZE=100

# Metrics (Prometheus scrape protection)
METRICS_ENABLED=true
METRICS_TOKEN=

# ===========================================
# Redis（JWT 会话 + 限流 + 登录锁定）
# ===========================================
# 用途：
#   - JWT access token 会话（jti）与 refresh token 存储
#   - Auth 端点 IP 限流（/auth/login、/auth/refresh 等）
#   - 登录暴力破解锁定（连续失败 5 次锁 15 分钟）
# 本地：docker compose up -d redis 后使用下方 URL
# 配置了 REDIS_URL 时，API 启动前会 ping Redis；未启动则拒绝启动并报错
# 留空 REDIS_URL 可跳过 Redis（refresh 回退 PostgreSQL，仅开发用）
REDIS_URL=redis://localhost:6379/0

# 多仓库（单仓业务保持 false，隐藏 UI + 后端始终用默认仓）
ENABLE_MULTI_WAREHOUSE=false

# ===========================================
# AI Configuration (Eino Framework - OpenAI Integration)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_HTTP_TIMEOUT_SEC=90
AI_TRANSLATE_RETRY_MAX=2
AI_RETRY_MAX_ATTEMPTS=10
AI_RETRY_INTERVAL_SEC=3

# Superadmin seed bootstrap (required for initial seed)
SEED_SUPERADMIN_EMAIL=admin@candypro.com
# Option A (recommended): pre-hashed bcrypt value
SEED_SUPERADMIN_PASSWORD_HASH=
# Option B: plain password (will be bcrypt-hashed during seed)
SEED_SUPERADMIN_PASSWORD=
