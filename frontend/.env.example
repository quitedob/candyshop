# ===========================================
# CandyPro OEM Frontend Configuration
# ===========================================

# API Configuration
API_BASE_URL=/api/v1
# Server-side API fetches and the /api proxy. Set the backend's reachable origin
# when building for deployment (for Docker, http://api:8080).
BACKEND_URL=http://localhost:8080
# Optional override; includes the versioned API prefix.
# INTERNAL_API_BASE=http://localhost:8080/api/v1
# Runtime override when the deployed backend differs from the build environment.
# NUXT_INTERNAL_API_BASE=http://api:8080/api/v1
# Optional build-time CMS snapshots; requires a reachable, intended content API.
# Default false leaves CMS pages dynamic and supports offline image builds.
PRERENDER_CMS=false

# Site Configuration
SITE_URL=https://candypro-oem.com

# Contact Information — set a real number (digits only, incl. country code).
# Leave empty to hide WhatsApp buttons instead of linking to a placeholder.
WHATSAPP_NUMBER=

# Google Maps API Key (optional — falls back to OpenStreetMap if empty)
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Feature flags (single-warehouse business)
NUXT_PUBLIC_ENABLE_MULTI_WAREHOUSE=false
NUXT_PUBLIC_JWT_ACCESS_MINUTES=15

# Playwright E2E (optional — negotiation-flow.spec.ts)
# PLAYWRIGHT_API_BASE=http://localhost:8080/api/v1
# E2E_ADMIN_EMAIL=admin@candypro.com
# E2E_ADMIN_PASSWORD=
# E2E_CUSTOMER_EMAIL=customer@example.com
# E2E_CUSTOMER_PASSWORD=
